# Copy this file to .env.local and fill in real values for local
# development. .env.local is git-ignored and never committed.
#
# See .env.development / .env.production for the non-secret defaults that
# ship per environment, and README.md for how these map to Vercel.

# ---------------------------------------------------------------------------
# Application (browser-safe — NEXT_PUBLIC_* is inlined into the client bundle)
# ---------------------------------------------------------------------------
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_NAME="GJD Maintenance"

# ---------------------------------------------------------------------------
# Logging (server-only)
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Email — booking/contact notifications (server-only)
# Required in production; optional elsewhere (falls back to console logging).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
BOOKING_EMAIL=

# ---------------------------------------------------------------------------
# Database (server-only) — not wired up yet, reserved for future use
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth (server-only) — not wired up yet, reserved for future use
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Object storage (server-only) — not wired up yet, reserved for future use
# ---------------------------------------------------------------------------
STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Webhooks (server-only) — not wired up yet, reserved for future use
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=
info@gjdsmaintenance.co.uk