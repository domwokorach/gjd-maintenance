# Loaded automatically by Next.js for production builds (`next build` /
# `next start`), which includes Vercel Preview deployments unless overridden.
#
# Non-secret defaults only. Real production secrets (RESEND_API_KEY,
# BOOKING_EMAIL, etc.) and any Preview-specific overrides are set in the
# Vercel dashboard per environment — dashboard variables take precedence
# over this file automatically, so it's safe to commit.
APP_ENV=production
NEXT_PUBLIC_APP_URL=https://gjdmaintenance.co.uk
NEXT_PUBLIC_API_URL=https://gjdmaintenance.co.uk/api
NEXT_PUBLIC_SITE_NAME="GJD Maintenance"

LOG_LEVEL=warn
