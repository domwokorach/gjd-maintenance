# Reference only — Next.js does not auto-load a ".env.staging" file (it only
# recognizes development/production/test). "Staging" here means Vercel
# Preview deployments, which build with NODE_ENV=production.
#
# Paste these into the Vercel dashboard → Project → Settings →
# Environment Variables, scoped to "Preview", so they override the
# .env.production defaults for preview builds only. See README.md.

APP_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.gjdmaintenance.co.uk
NEXT_PUBLIC_API_URL=https://staging.gjdmaintenance.co.uk/api
NEXT_PUBLIC_SITE_NAME="GJD Maintenance (Staging)"

LOG_LEVEL=info

# Use staging-only credentials — never point Preview deployments at
# production email, database, storage, or auth secrets.
RESEND_API_KEY=
BOOKING_EMAIL=
