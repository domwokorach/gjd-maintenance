# Loaded automatically by Next.js when NODE_ENV=development (i.e. `next dev`).
# Non-secret defaults only — real secrets go in .env.local (git-ignored).
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_NAME="GJD Maintenance"

LOG_LEVEL=debug
